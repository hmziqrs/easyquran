# Development commands. `just` with no argument lists them.
#
# Gates: `just check && just test` (on battery: `cargo fmt --all -- --check`
# and `cargo check --workspace --all-targets` only).

default:
    @just --list

# Formatting check and clippy with warnings denied, whole workspace.
check:
    cargo fmt --all -- --check
    cargo clippy --workspace --all-targets -- -D warnings

# eq-core unit tests and the headless UI tests.
test:
    cargo test --workspace

# Desktop run on this machine's native backend.
run:
    cargo run

# iOS simulator run. Uses a booted simulator, else the newest iPhone.
run-ios:
    nsh run --target ios

# Android run on the first device `adb` lists. Uses Android Studio's JDK when
# JAVA_HOME is unset: /usr/bin/java is a stub with no runtime behind it.
run-android:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -z "${JAVA_HOME:-}" ] && [ -d "/Applications/Android Studio.app/Contents/jbr/Contents/Home" ]; then
        export JAVA_HOME="/Applications/Android Studio.app/Contents/jbr/Contents/Home"
    fi
    nsh run --target android

# Installable builds into .nsh/out: macOS .app, iOS simulator .app, Android .apk.
package:
    nsh package --target macos
    nsh package --target ios-simulator
    nsh package --target android

# Bundles the default Arabic script (the reader's default source,
# uthmani-annotated) into assets/quran/ so a first launch reads offline.
# Copies from the monorepo's provisioned db/quran (read-only, never edited);
# assets/quran/ is gitignored. The size must match the baked map.
quran-bundle:
    #!/usr/bin/env bash
    set -euo pipefail
    # EQ_QURAN_DIR overrides the source tree (a worktree has no db/).
    src="${EQ_QURAN_DIR:-../db/quran}/arabic/quran-uthmani-annotated.sqlite"
    expected=1605632
    if [ ! -f "$src" ]; then echo "missing $src (provision db/quran from R2 first)" >&2; exit 1; fi
    size=$(wc -c < "$src" | tr -d ' ')
    if [ "$size" != "$expected" ]; then echo "$src is $size bytes, expected $expected" >&2; exit 1; fi
    mkdir -p assets/quran
    cp "$src" assets/quran/quran-uthmani-annotated.sqlite
    echo "bundled assets/quran/quran-uthmani-annotated.sqlite ($size bytes)"

{
  "name": "EasyQuran",
  "id": "fyi.easyquran.app",
  "version": "1.0.0",
  "build": 1,
  "icon": "assets/icon.png",
  "appearance": "system",
  "theme": "themes/theme.json",
  "rust": ".",
  "root": "App",
  "schemes": ["easyquran", "fyi.easyquran.app"],
  "links": [
    { "host": "easyquran.fyi" },
    { "host": "www.easyquran.fyi" }
  ],
  "handoff": true,
  "capabilities": {
    "windows": true,
    "application": true,
    "network": { "hosts": ["easyquran.fyi", "localhost", "127.0.0.1", "10.0.2.2", "oauth2.googleapis.com", "discord.com", "graph.facebook.com","www.google-analytics.com"] },
    "audio": true,
    "notifications": true,
    "openUrl": { "schemes": ["https", "mailto"] },
    "fs": { "read": ["${dataDir}"], "write": ["${dataDir}"] },
    "clipboard": true,
    "picker": true,
    "speech": true,
    "share": true
  },
  "dependencies": {
    "nsh-extra": { "version": "^0.7.1", "features": ["speech"] }
  }
}

{
  "name": "EasyQuran",
  "id": "fyi.easyquran.app",
  "version": "1.0.0",
  "build": 1,
  "icon": "assets/icon.png",
  "appearance": "system",
  "theme": "themes/theme.json",
  "rust": ".",
  "root": "App",
  "capabilities": {
    "network": { "hosts": ["easyquran.fyi", "localhost", "127.0.0.1"] },
    "audio": true,
    "notifications": true,
    "openUrl": { "schemes": ["https", "mailto"] },
    "fs": { "read": ["${dataDir}"], "write": ["${dataDir}"] },
    "clipboard": true,
    "picker": true,
    "speech": true
  }
}

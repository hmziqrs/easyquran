:8080 {
	encode zstd gzip
	root * /srv

	header Cache-Control "no-cache"

	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@pack path_regexp ^/offline/pack\.[0-9a-f]+\.json$
	header @pack Cache-Control "public, max-age=31536000, immutable"

	@robots path *.md *.txt
	header @robots X-Robots-Tag "noindex, follow"

	handle_errors {
		rewrite * /404.html
		file_server { precompressed br gzip }
	}

	file_server { precompressed br gzip }
}

# EasyQuran deploy config — copy to deploy/.env and fill in:
#   cp deploy/.env.example deploy/.env
# Used for compose interpolation (${...}) AND the api container runtime env.
# Never commit a real deploy/.env (gitignored).

# --- app / routing ---------------------------------------------------------
PROJECT=easyquran
DOMAIN=easyquran.fyi

# Contract with the EXTERNAL Traefik (not in this repo). Dokploy runs Traefik on
# `dokploy-network` with entrypoint `websecure` + resolver `letsencrypt` — these
# defaults match a stock Dokploy install; confirm if you customized Traefik.
PROXY_NETWORK=dokploy-network
HTTPS_ENTRYPOINT=websecure
ACME_RESOLVER=letsencrypt

# --- dual API URL ----------------------------------------------------------
# PUBLIC  → baked into the client bundle (browser calls it).
PUBLIC_API_BASE_URL=https://easyquran.fyi/api
PUBLIC_QURAN_API_BASE=https://easyquran.fyi/api/quran
# INTERNAL → build/prerender only (never shipped). Forward-ready: used once the
# /quran SSG flow lands; the build currently reads local sqlite directly.
INTERNAL_API_BASE_URL=http://api:8888
INTERNAL_QURAN_API_BASE=http://api:8888/quran

# --- translated-page SSR disk cache ---------------------------------------
QURAN_SSR_CACHE_TTL_MS=604800000
QURAN_SSR_CACHE_BUDGET_BYTES=268435456

# --- Quran SQLite source ---------------------------------------------------
# Nothing to set: Docker builds are always production and download the Quran
# SQLite artifacts from R2. `PUBLIC_ENV` exists only for the local dev server.

# --- api runtime (HOST/PORT/DATABASE_URL are forced by compose) ------------
RUST_LOG=info
RUST_ENV=production
# Cookie-signing key:  openssl rand -hex 32
COOKIE_KEY=CHANGE_ME_openssl_rand_hex_32
# Field-level encryption key (required in production): openssl rand -base64 32 | head -c 32
FIELD_ENC_KEY=CHANGE_ME_32_raw_bytes_from_openssl_rand_base64
# ConnectInfo if the VPS is hit directly; CfConnectingIp behind Cloudflare proxy.
IP_SOURCE=ConnectInfo

# Backend boot check is fail-closed without these — dummy values satisfy it
# (the Quran reader never uses media/S3 or mail/SMTP). Set real ones only if you
# wire those features.
S3_REGION=auto
S3_ACCOUNT_ID=local
S3_BUCKET=easyquran-assets
S3_ACCESS_KEY=devkey
S3_SECRET_KEY=devsecret
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=https://r2.easyquran.fyi
# Mail. "none" = no mail (drops messages, ZERO credentials needed) — the default,
# since the reader doesn't send email. Switch to "cloudflare" (set the
# CLOUDFLARE_EMAIL_* keys) or "smtp" when you wire email.
MAIL_PROVIDER=none
MAIL_FROM_ADDRESS=no-reply@easyquran.fyi
MAIL_FROM_NAME=EasyQuran
# Required only when MAIL_PROVIDER=smtp:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

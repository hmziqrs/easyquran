# EasyQuran deploy config — copy to deploy/.env and fill in:
#   cp deploy/.env.example deploy/.env
# Used for compose interpolation (${...}) AND the api container runtime env.
# Never commit a real deploy/.env (gitignored).

# --- app / routing ---------------------------------------------------------
PROJECT=easyquran
DOMAIN=easyquran.fyi

# Contract with the EXTERNAL Traefik (not in this repo). Dokploy runs Traefik on
# `dokploy-network` with entrypoint `websecure` + resolver `letsencrypt` — these
# defaults match a stock Dokploy install; confirm if you customized Traefik.
PROXY_NETWORK=dokploy-network
HTTPS_ENTRYPOINT=websecure
ACME_RESOLVER=letsencrypt

# --- dual API URL ----------------------------------------------------------
# PUBLIC  → baked into the client bundle (browser calls it).
PUBLIC_API_BASE_URL=https://easyquran.fyi/api
PUBLIC_QURAN_API_BASE=https://easyquran.fyi/api/quran
# INTERNAL → build/prerender only (never shipped). Forward-ready: used once the
# /quran SSG flow lands; the build currently reads local sqlite directly.
INTERNAL_API_BASE_URL=http://api:8888
INTERNAL_QURAN_API_BASE=http://api:8888/quran

# --- translated-page SSR disk cache ---------------------------------------
QURAN_SSR_CACHE_TTL_MS=604800000
QURAN_SSR_CACHE_BUDGET_BYTES=268435456

# --- translation pool: demand + prewarm (operability) ---------------------
# Demand collection counts which translations readers touch into a lock-free
# side table and persists a decayed score (~60s) so a restart can prewarm the
# likely cold-start set. DEFAULT ON. Flip off to make the pool purely
# on-demand (no side table, no persistence, no boot prewarm). Collection-off
# ⇒ prewarm-off: QURAN_PREWARM_TRANSLATIONS is ignored when this is false.
QURAN_DEMAND_COLLECT=true
# How many ranked translations to warm into the pool at boot (load_ranked →
# prewarm). 0 = prewarm off but collection/persistence still run. Default 2;
# raise only if cold-start latency on the long tail warrants the residency.
QURAN_PREWARM_TRANSLATIONS=2

# --- Quran SQLite source ---------------------------------------------------
# Nothing to set: Docker builds are always production and download the Quran
# SQLite artifacts from R2. `PUBLIC_ENV` exists only for the local dev server.

# --- api runtime (HOST/PORT/DATABASE_URL are forced by compose) ------------
RUST_LOG=info
RUST_ENV=production
# Cookie-signing key:  openssl rand -hex 32
COOKIE_KEY=CHANGE_ME_openssl_rand_hex_32
# Field-level encryption key (required in production): openssl rand -base64 32 | head -c 32
FIELD_ENC_KEY=CHANGE_ME_32_raw_bytes_from_openssl_rand_base64
# Behind Cloudflare→Traefik the verified client IP is CF-Connecting-IP. EXACT
# PascalCase variant — `cf-connecting-ip`/`connect-info` are invalid. ConnectInfo
# is rejected in production (it would rate-limit on the proxy IP). Restrict
# origin ingress to Cloudflare ranges before enabling (deploy/README.md).
IP_SOURCE=CfConnectingIp
# CORS origin allowlist for the PRIVATE /api router. Same-origin POSTs (login,
# register, CSRF) always carry an Origin header; any Origin not on this list is
# rejected with 403. Write every domain out LITERALLY — Compose does NOT expand
# ${...} inside env_file values, so ALLOWED_ORIGINS=https://${DOMAIN} would reach
# the API as that literal string and silently reject every login (parses clean,
# matches nothing). Production accepts HTTPS origins only and REQUIRES
# https://easyquran.fyi in the list; localhost/LAN origins are dev-only.
ALLOWED_ORIGINS=https://easyquran.fyi,https://hmziq.rs,https://hzmiqrs.com,https://blog.hmziq.rs
# Trusted Docker-internal SSR (Bun) token — required in production. Constant-time
# compared by the API identity gate; never put this in a PUBLIC_ env var, a
# response, or a log. Generate with: openssl rand -hex 32
INTERNAL_QURAN_API_TOKEN=CHANGE_ME_openssl_rand_hex_32
# Isolated non-escalating buckets (must be > 0 in production):
#   internal — trusted Bun SSR on the public Quran router
#   health   — public readiness (/quran/health/ready)
QURAN_INTERNAL_REQUESTS_PER_MINUTE=600
QURAN_HEALTH_REQUESTS_PER_MINUTE=120

# --- ban inspection / export (operator + proxy adapter) --------------------
# Read-only bearer token for GET /admin/bans/export (machine access). Compared
# constant-time; NEVER accepted by the list/delete mutation routes (those need an
# admin session). Leave unset to disable machine access (human admin ACL still
# works). Generate with: openssl rand -hex 32
# BAN_EXPORT_TOKEN=

# Upper bound on concurrent active bans (Temp + Long) held in L1/L2. At capacity
# the engine keeps existing bans, declines new ban creation, continues fixed
# limiting, and increments a saturation counter.
QURAN_ACTIVE_BAN_MAX=2000

# --- W3a ban escalation (DEFAULT OFF — leaves the request path untouched) ---
# When true, a suspicious sustained rate-limit abuser (qualifying fixed windows
# whose suspicious 4xx count meets the threshold) is escalated to a durable
# Temp then Long ban under quran-ban:{banUnit}. Stays disabled until the hard
# gates pass: W2 ingress proof + W3b + W3c + a valid CIDR allowlist.
QURAN_BAN_ESCALATION_ENABLED=false
# Required when QURAN_BAN_ESCALATION_ENABLED=true (even if empty for no
# exceptions). Comma-separated CIDRs matched against the RAW client IP before
# BanUnit normalization; an allowlisted unit never escalates and never appears in
# export. IPv6 prefixes NARROWER than /64 are rejected (proxy export blocks /64
# units and cannot preserve a narrower exception).
# Example (no exceptions): QURAN_BAN_ALLOWLIST=
# Example (exempt a /24 + a /64): QURAN_BAN_ALLOWLIST=203.0.113.0/24,2001:db8::/64
QURAN_BAN_ALLOWLIST=
# Max distinct units tracked in L1 escalation history (qualifying-window stamps).
QURAN_ESCALATION_MAX_IDENTITIES=10000

# Backend boot check is fail-closed without these — dummy values satisfy it
# (the Quran reader never uses media/S3 or mail/SMTP). Set real ones only if you
# wire those features.
S3_REGION=auto
S3_ACCOUNT_ID=local
S3_BUCKET=easyquran-assets
S3_ACCESS_KEY=devkey
S3_SECRET_KEY=devsecret
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=https://r2.easyquran.fyi
# Mail. "none" = no mail (drops messages, ZERO credentials needed) — the default,
# since the reader doesn't send email. Switch to "cloudflare" (set the
# CLOUDFLARE_EMAIL_* keys) or "smtp" when you wire email.
MAIL_PROVIDER=none
MAIL_FROM_ADDRESS=no-reply@easyquran.fyi
MAIL_FROM_NAME=EasyQuran
# Required only when MAIL_PROVIDER=smtp:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# --- web auth / OAuth + passkeys (W8f — DEFAULT OFF) ------------------------
# Production web-auth configuration. WEB_AUTH_ENABLED mounts the auth router;
# when off (the default) the router is not mounted and none of the below is
# required. Flip to true only once every provider has real credentials, an HTTPS
# callback whose origin matches OAUTH_ALLOWED_REDIRECT_ORIGINS, AND a real mail
# transport (production with WEB_AUTH_ENABLED=true rejects MAIL_PROVIDER=none —
# set MAIL_PROVIDER=smtp|cloudflare + SMTP_*/CLOUDFLARE_EMAIL_* in the mail
# section above). Spell easyquran.fyi LITERALLY: compose does NOT expand ${...}
# inside env_file values, so any ${DOMAIN} interpolation would reach the API
# verbatim and silently break every login/redirect.
WEB_AUTH_ENABLED=false
WEB_OAUTH_PROVIDERS=google,apple,facebook,github

# Frontend origin — provider callbacks must match this.
FRONTEND_URL=https://easyquran.fyi
OAUTH_ALLOWED_REDIRECT_ORIGINS=https://easyquran.fyi

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://easyquran.fyi/api/auth/google/v1/callback

# Apple (Sign in with Apple) — one of APPLE_PRIVATE_KEY or APPLE_PRIVATE_KEY_PATH
# is required.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_PATH=
APPLE_REDIRECT_URI=https://easyquran.fyi/api/auth/apple/v1/callback

# Facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=https://easyquran.fyi/api/auth/facebook/v1/callback

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://easyquran.fyi/api/auth/github/v1/callback

# WebAuthn (passkeys) — production rejects localhost/default RP values. RP ID is
# the registrable domain (no scheme); RP origin is the full HTTPS origin.
WEBAUTHN_RP_ID=easyquran.fyi
WEBAUTHN_RP_ORIGIN=https://easyquran.fyi
WEBAUTHN_RP_NAME=EasyQuran

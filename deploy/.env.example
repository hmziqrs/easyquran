# EasyQuran production deploy config (Dokploy / single VPS, web + api co-located).
# Copy to .env at the repo root, or set in the Dokploy Environment tab.

# Compose does NOT expand ${...} inside env_file values — write LITERALS (see ALLOWED_ORIGINS).

# Images (optional; CI pushes every master push/tag, or `just push` by hand)
# REGISTRY=ghcr.io/hmziqrs
# VERSION=latest

# ── Required ────────────────────────────────────────────────────────────────

# Public domain; compose derives ORIGIN, PUBLIC_*_API_BASE and Traefik Host labels from it.
DOMAIN=easyquran.fyi

# Reuse across redeploys/migrations; regenerating invalidates every session.  openssl rand -hex 32
COOKIE_KEY=CHANGE_ME_openssl_rand_hex_32

# AES-256, exactly 32 raw bytes; reuse forever (no rotation path).  openssl rand -base64 32 | head -c 32
FIELD_ENC_KEY=CHANGE_ME_32_raw_bytes

# Web->api SSR token (constant-time compared).  openssl rand -hex 32
INTERNAL_QURAN_API_TOKEN=CHANGE_ME_openssl_rand_hex_32

# CORS allowlist for the private /api router; literal HTTPS CSV, must include https://<DOMAIN>.
ALLOWED_ORIGINS=https://easyquran.fyi,https://hmziq.rs,https://hzmiqrs.com,https://blog.hmziq.rs

# ── Optional overrides (compose defaults are stock Dokploy) ─────────────────

# PROXY_NETWORK=dokploy-network
# HTTPS_ENTRYPOINT=websecure
# ACME_RESOLVER=letsencrypt

# Quran corpus: default quran_data volume, refilled by quran-init each redeploy; absolute host path = bind mount.
# QURAN_DB_DIR=

# Read-only token for GET /admin/bans/export; unset = disabled.  openssl rand -hex 32
# BAN_EXPORT_TOKEN=

# Media storage (R2): shares the publisher's token, endpoint derives from R2_ACCOUNT_ID, region is always auto.
# S3_BUCKET=easyquran-assets
# S3_PUBLIC_URL=https://r2.easyquran.fyi
# Overrides only: S3_ENDPOINT / S3_ACCOUNT_ID / S3_REGION / S3_ACCESS_KEY / S3_SECRET_KEY

# Quran rate limits / ban tuning (defaults shown)
# QURAN_INTERNAL_REQUESTS_PER_MINUTE=600
# QURAN_HEALTH_REQUESTS_PER_MINUTE=120
# QURAN_ACTIVE_BAN_MAX=2000
# QURAN_DEMAND_COLLECT=true
# QURAN_PREWARM_TRANSLATIONS=2
# QURAN_SSR_CACHE_TTL_MS=604800000
# QURAN_SSR_CACHE_BUDGET_BYTES=268435456
# QURAN_BAN_ESCALATION_ENABLED=false
# QURAN_BAN_ALLOWLIST=
# QURAN_ESCALATION_MAX_IDENTITIES=10000

# ── Web auth / OAuth + passkeys (DEFAULT OFF) ───────────────────────────────

# Prod rejects MAIL_PROVIDER=none; every listed provider needs its id+secret; FRONTEND_URL derives from DOMAIN in compose.
# WEB_AUTH_ENABLED=false
# FRONTEND_URL=https://easyquran.fyi
# WEB_OAUTH_PROVIDERS=github,discord

# Mail (smtp connects lazily; cloudflare needs the CLOUDFLARE_EMAIL_* keys instead)
# MAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Provider credentials — fill the ones in WEB_OAUTH_PROVIDERS (callback URLs derive from FRONTEND_URL)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# APPLE_PRIVATE_KEY_PATH=

# Overrides only: OAUTH_ALLOWED_REDIRECT_ORIGINS / *_REDIRECT_URI / WEBAUTHN_RP_ID / WEBAUTHN_RP_ORIGIN / WEBAUTHN_RP_NAME
# Native mobile audiences (omit when the SDK uses the web client ids): GOOGLE_MOBILE_CLIENT_IDS / APPLE_MOBILE_CLIENT_IDS
# Native GitHub authorization must request the user:email scope to create or link an account.

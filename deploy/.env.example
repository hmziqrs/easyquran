# EasyQuran production deploy config (Dokploy / single VPS, web+api co-located).
#
# Copy to .env at the repo root (or set in the Dokploy Environment tab, which
# writes that same file). The api container reads it via env_file: [.env].
#
# This is the MINIMAL required set (5 vars). Everything else is either:
#  - hardcoded in docker-compose.yml as a co-location invariant (RUST_ENV,
#    IP_SOURCE, INTERNAL_QURAN_API_BASE, HOST/PORT, DATABASE_URL), or
#  - an interpolated compose default you may override below (S3_*, MAIL_*,
#    PROXY_NETWORK, rate limits, ban/escalation tuning), or
#  - a safe code default (all QURAN_* tuning, SSR cache TTL/budget).
#
# Compose does NOT expand ${...} inside these env_file values — write LITERALS
# (see ALLOWED_ORIGINS). Only the 5 below are required to boot in production.

# ── Images (optional) ───────────────────────────────────────────────────────
# The stack never builds; it pulls images pushed from a dev machine (`just push`).
# Defaults: REGISTRY=ghcr.io/hmziqrs, VERSION=latest. Pin VERSION to a release tag
# (VERSION=v1.0.0) to stop tracking `latest`.
# REGISTRY=ghcr.io/hmziqrs
# VERSION=latest

# ── Required (5) ────────────────────────────────────────────────────────────

# The public domain. Everything browser-facing derives from this in compose
# (ORIGIN, PUBLIC_*_API_BASE, Traefik Host labels).
DOMAIN=easyquran.fyi

# Cookie-signing / keyed-hash secret. REUSE the same value across redeploys and
# VPS migrations — regenerating invalidates every active session. Generate once
# for a brand-new deploy:  openssl rand -hex 32
COOKIE_KEY=CHANGE_ME_openssl_rand_hex_32

# Field-level encryption key (AES-256, exactly 32 raw bytes). REUSE across
# redeploys/migrations — regenerating renders every encrypted field undecryptable
# (no rotation path). Generate once for a brand-new deploy:
#   FIELD_ENC_KEY="$(openssl rand -base64 32 | head -c 32)"
FIELD_ENC_KEY=CHANGE_ME_32_raw_bytes

# Trusted Docker-internal SSR token (web->api on the private network). Constant-
# time compared by the api identity gate. Server-only: never under a PUBLIC_ var,
# never in a response or log.  openssl rand -hex 32
INTERNAL_QURAN_API_TOKEN=CHANGE_ME_openssl_rand_hex_32

# CORS origin allowlist for the PRIVATE /api router. LITERAL CSV — compose does
# NOT expand ${DOMAIN} here, so when you change DOMAIN above you MUST also update
# the apex entry below or every login silently 403s (parses clean, matches
# nothing). HTTPS origins only; production REQUIRES https://easyquran.fyi listed.
ALLOWED_ORIGINS=https://easyquran.fyi,https://hmziq.rs,https://hzmiqrs.com,https://blog.hmziq.rs

# ── Optional overrides (defaults are baked into docker-compose.yml) ─────────
# Uncomment + set ONLY if your install is non-stock or you wire the feature.

# External Traefik topology (defaults match a stock Dokploy install):
# PROXY_NETWORK=dokploy-network
# HTTPS_ENTRYPOINT=websecure
# ACME_RESOLVER=letsencrypt

# Read-only bearer token for GET /admin/bans/export (machine access). Unset =
# disabled (human admin ACL still works).  openssl rand -hex 32
# BAN_EXPORT_TOKEN=

# Media object storage — wire ONLY if you enable media uploads. These override
# the compose S3_* dummies (R2 / Garage / MinIO / AWS S3).
# S3_REGION=auto
# S3_ACCOUNT_ID=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=
# S3_PUBLIC_URL=

# Quran rate-limit / ban tuning (defaults shown):
# QURAN_INTERNAL_REQUESTS_PER_MINUTE=600
# QURAN_HEALTH_REQUESTS_PER_MINUTE=120
# QURAN_ACTIVE_BAN_MAX=2000
# QURAN_DEMAND_COLLECT=true
# QURAN_PREWARM_TRANSLATIONS=2
# Translated-page SSR disk cache:
# QURAN_SSR_CACHE_TTL_MS=604800000
# QURAN_SSR_CACHE_BUDGET_BYTES=268435456
# Ban escalation (DEFAULT OFF — leave allowlist unset/commented while disabled):
# QURAN_BAN_ESCALATION_ENABLED=false
# QURAN_BAN_ALLOWLIST=
# QURAN_ESCALATION_MAX_IDENTITIES=10000

# ── Web auth / OAuth + passkeys (DEFAULT OFF) ───────────────────────────────
# Flip WEB_AUTH_ENABLED=true ONLY once every provider is credentialed, an HTTPS
# callback origin matches OAUTH_ALLOWED_REDIRECT_ORIGINS, AND a real mail
# transport is configured. Prod with WEB_AUTH_ENABLED=true REJECTS
# MAIL_PROVIDER=none — set MAIL_PROVIDER (overriding the compose default) +
# SMTP_* below, or CLOUDFLARE_EMAIL_*. Spell every domain LITERALLY here (compose
# does not expand ${...} in this file).
# WEB_AUTH_ENABLED=false
# WEB_OAUTH_PROVIDERS=google,apple,facebook,github
# FRONTEND_URL=https://easyquran.fyi
# OAUTH_ALLOWED_REDIRECT_ORIGINS=https://easyquran.fyi
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET= / GOOGLE_REDIRECT_URI=https://easyquran.fyi/api/auth/google/v1/callback
# APPLE_CLIENT_ID= / APPLE_TEAM_ID= / APPLE_KEY_ID= / APPLE_PRIVATE_KEY= (or APPLE_PRIVATE_KEY_PATH=) / APPLE_REDIRECT_URI=https://easyquran.fyi/api/auth/apple/v1/callback
# FACEBOOK_CLIENT_ID= / FACEBOOK_CLIENT_SECRET= / FACEBOOK_REDIRECT_URI=https://easyquran.fyi/api/auth/facebook/v1/callback
# GITHUB_CLIENT_ID= / GITHUB_CLIENT_SECRET= / GITHUB_REDIRECT_URI=https://easyquran.fyi/api/auth/github/v1/callback
# WEBAUTHN_RP_ID=easyquran.fyi / WEBAUTHN_RP_ORIGIN=https://easyquran.fyi / WEBAUTHN_RP_NAME=EasyQuran
# MAIL_PROVIDER=smtp        # overrides the compose default (none)
# SMTP_HOST= / SMTP_PORT=587 / SMTP_USERNAME= / SMTP_PASSWORD=

# Native (mobile) provider-token sign-in — POST /auth/{provider}/v1/token.
# EXTRA ID-token audiences, needed ONLY when a native SDK mints tokens for its
# own client ID instead of the web/server one above. Comma-separated; omit when
# the SDK requests tokens for GOOGLE_CLIENT_ID / APPLE_CLIENT_ID.
# GOOGLE_MOBILE_CLIENT_IDS=      # Android/iOS OAuth client IDs
# APPLE_MOBILE_CLIENT_IDS=       # iOS/macOS bundle IDs
# Facebook and GitHub need no extra vars: both validate the native access token
# against the same app credentials listed above. GitHub native authorization
# must request the user:email scope to create or link an account (an existing
# provider link signs in without it).

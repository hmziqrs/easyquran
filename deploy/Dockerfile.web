# Build stays on Node: prerendering the Arabic routes reads the sqlite corpus through
# `node:sqlite`, which bun does not implement ("No such built-in module"). Every route that
# touches sqlite is `prerender = true`, so the dependency is build-time only — the runtime
# below never loads it.
FROM node:24-slim AS build
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@11.15.1 --activate

COPY pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY web/ ./web/
COPY db/quran/tanzil/arabic/quran-uthmani.sqlite ./db/quran/tanzil/arabic/quran-uthmani.sqlite
RUN sed -i '/db\/quran\/tanzil\/translations/d' pnpm-workspace.yaml

ENV PUBLIC_ENV=prod

ARG VERSION=dev
ENV BUILD_VERSION=${VERSION}

RUN pnpm install && pnpm --filter web build

# Runtime on bun: same adapter-node server, roughly half the resident memory of Node under
# translation SSR (bench/ measured 211 MB vs 375 MB at 1k req/s), and it holds throughput where
# Node folds. Pinned deliberately — bump to 1.4 once it has a stable tag.
FROM oven/bun:1.3.14-slim
WORKDIR /app
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8080 \
    QURAN_SSR_CACHE_DIR=/app/cache/quran-ssr
RUN mkdir -p /app/cache/quran-ssr && chown -R bun:bun /app
COPY --from=build --chown=bun:bun /repo/web/build /app/build
COPY --from=build --chown=bun:bun /repo/web/server.ts /app/server.ts

ARG VERSION=dev
LABEL org.opencontainers.image.title="EasyQuran Web" \
      org.opencontainers.image.description="EasyQuran SvelteKit adapter-node frontend (Arabic SSG + translation SSR)" \
      org.opencontainers.image.source="https://github.com/hmziqrs/easyquran" \
      org.opencontainers.image.version="${VERSION}" \
      easyquran.component="web"

EXPOSE 8080
USER bun
CMD ["bun", "server.ts"]

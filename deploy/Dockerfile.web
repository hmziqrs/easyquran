FROM node:24-slim AS build
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@11.15.1 --activate

COPY pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY web/ ./web/
COPY db/quran/tanzil/arabic/quran-uthmani.sqlite ./db/quran/tanzil/arabic/quran-uthmani.sqlite
RUN sed -i '/db\/quran\/tanzil\/translations/d' pnpm-workspace.yaml

ARG PUBLIC_API_BASE_URL=https://easyquran.fyi/api
ARG INTERNAL_API_BASE_URL=http://api:8888
ENV PUBLIC_API_BASE_URL=${PUBLIC_API_BASE_URL}
ENV INTERNAL_API_BASE_URL=${INTERNAL_API_BASE_URL}

ARG VERSION=dev
ENV BUILD_VERSION=${VERSION}

RUN pnpm install && pnpm --filter web build

FROM caddy:2-alpine
COPY --from=build /repo/web/build /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile

ARG VERSION=dev
LABEL org.opencontainers.image.title="EasyQuran Web" \
      org.opencontainers.image.description="EasyQuran SvelteKit SSG frontend (Caddy static)" \
      org.opencontainers.image.source="https://github.com/hmziqrs/easyquran" \
      org.opencontainers.image.version="${VERSION}" \
      easyquran.component="web"

EXPOSE 8080
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]

# EasyQuran Web — packaging only. NOTHING is compiled here.
#
# The SvelteKit build runs outside Docker (on the CI runner or your machine via
# `just image-web`, which shells out to `pnpm --filter web build`), because building it
# inside Docker meant re-installing the toolchain, re-downloading CA certs, and re-running
# the sqlite prerender on every image — the single most fragile step in this repo.
# adapter-node emits a self-contained bundle
# (`web/build`) and `server.ts` imports nothing but `node:http` + that bundle, so the image
# is two COPYs. The output is pure JS: arch-independent, no node_modules, no network.
#
# Build via `just image-web` — it guarantees the artifacts exist and are fresh. A bare
# `docker build -f deploy/Dockerfile.web .` fails on the missing `web/build` COPY, by design.
#
# Context = repo root, filtered by deploy/Dockerfile.web.dockerignore (BuildKit reads the
# per-Dockerfile ignore file in preference to the root .dockerignore, which excludes
# web/build for the api/source builds).
FROM oven/bun:1.4.0-slim
WORKDIR /app
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8080 \
    QURAN_SSR_CACHE_DIR=/app/cache/quran-ssr
RUN mkdir -p /app/cache/quran-ssr && chown -R bun:bun /app

COPY --chown=bun:bun web/build /app/build
COPY --chown=bun:bun web/server.ts /app/server.ts

ARG VERSION=dev
LABEL org.opencontainers.image.title="EasyQuran Web" \
      org.opencontainers.image.description="EasyQuran SvelteKit adapter-node frontend (Arabic SSG + translation SSR)" \
      org.opencontainers.image.source="https://github.com/hmziqrs/easyquran" \
      org.opencontainers.image.version="${VERSION}" \
      easyquran.component="web"

EXPOSE 8080
USER bun
CMD ["bun", "server.ts"]

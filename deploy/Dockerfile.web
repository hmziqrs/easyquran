FROM node:24-slim AS build
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@11.15.1 --activate

COPY pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY web/ ./web/
COPY db/quran/tanzil/arabic/quran-uthmani.sqlite ./db/quran/tanzil/arabic/quran-uthmani.sqlite
RUN sed -i '/db\/quran\/tanzil\/translations/d' pnpm-workspace.yaml

ARG PUBLIC_API_BASE_URL=https://easyquran.fyi/api
ARG PUBLIC_QURAN_API_BASE=https://easyquran.fyi/api/quran
ARG INTERNAL_API_BASE_URL=http://api:8888
ENV PUBLIC_API_BASE_URL=${PUBLIC_API_BASE_URL}
ENV PUBLIC_QURAN_API_BASE=${PUBLIC_QURAN_API_BASE}
ENV INTERNAL_API_BASE_URL=${INTERNAL_API_BASE_URL}
ENV PUBLIC_ENV=prod

ARG VERSION=dev
ENV BUILD_VERSION=${VERSION}

RUN pnpm install && pnpm --filter web build

FROM node:24-slim
WORKDIR /app
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8080 \
    QURAN_SSR_CACHE_DIR=/app/cache/quran-ssr
RUN mkdir -p /app/cache/quran-ssr && chown -R node:node /app
COPY --from=build --chown=node:node /repo/web/build /app/build
COPY --from=build --chown=node:node /repo/web/server.mjs /app/server.mjs

ARG VERSION=dev
LABEL org.opencontainers.image.title="EasyQuran Web" \
      org.opencontainers.image.description="EasyQuran SvelteKit adapter-node frontend (Arabic SSG + translation SSR)" \
      org.opencontainers.image.source="https://github.com/hmziqrs/easyquran" \
      org.opencontainers.image.version="${VERSION}" \
      easyquran.component="web"

EXPOSE 8080
USER node
CMD ["node", "server.mjs"]

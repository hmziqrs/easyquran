# =============================================================================
# Production deploy environment — copy to `deploy.env` and fill with real values.
#   cp backend/docker/deploy.env.example backend/docker/deploy.env
#
# This file is the single source for BOTH:
#   1. compose interpolation (vars referenced as ${VAR} in
#      backend/docker/docker-compose.prod.yml) — requires the stack to be
#      brought up with `--env-file deploy.env`; and
#   2. the backend container runtime env (the service lists it under `env_file`).
#
# NEVER commit a real deploy.env. Add it to .gitignore on the VPS checkout.
# =============================================================================

# --- Compose interpolation + routing ----------------------------------------
# Project slug. Containers are named ${PROJECT}_backend / ${PROJECT}_watchtower,
# and the shared external network is ${PROJECT}_network (created by the Traefik
# stack — bring that up first).
PROJECT=ruxlog
# Fully-qualified image reference Watchtower will poll. Point :latest at a
# floating tag for auto-updates, or pin to a semver tag (e.g. :v1.2.3) for
# predictable rollouts.
BACKEND_IMAGE=ghcr.io/<owner>/ruxlog:latest
# Public hostname fronted by Traefik (must match the DNS record pointing at the
# VPS). Used by the backend's Host(`...`) router label.
BACKEND_DOMAIN=api.example.com
# ACME email passed to the Traefik stack (referenced by backend/traefik/.env.prod).
ACME_EMAIL=you@example.com

# --- Backend app runtime ----------------------------------------------------
# HOST/PORT are forced to 0.0.0.0:8888 by docker-compose.prod.yml (they must
# match the healthcheck and the Traefik http://api:8888 target) — do NOT set
# them here.
RUST_LOG=info

# --- Database (SQLite) ------------------------------------------------------
# SQLite is a single file. The app reads DATABASE_URL (see db/sea_connect.rs);
# docker-compose.prod.yml forces this same value and persists the file under
# /app/data via the backend_data volume. mode=rwc creates the file on first run.
DATABASE_URL=sqlite:./data/easyquran.db?mode=rwc

# --- Client IP (Cloudflare → Traefik → backend) ----------------------------
# The app sits behind Traefik (behind Cloudflare), so the TCP peer is Traefik,
# not the user. IP_SOURCE selects which header carries the real client IP for
# the rate-limit / abuse limiter. CfConnectingIp reads Cloudflare's authoritative
# CF-Connecting-IP (Traefik passes it through). ConnectInfo (the code default)
# uses the TCP peer — only correct when the app is directly exposed (dev).
IP_SOURCE=CfConnectingIp

# --- Crypto / session keys --------------------------------------------------
# CSPRNG keys (generate with `openssl rand -hex 32`). The COOKIE_KEY length is
# checked at boot — rotate before the first real deploy.
COOKIE_KEY=change-me-openssl-rand-hex-32
NEW_KEY=ACCELERATE

# --- Email (SMTP) -----------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_USERNAME=postmaster@example.com
SMTP_PASSWORD=change-me
SMTP_PORT=587

# --- Object storage (S3-compatible; R2 / Garage / etc.) ---------------------
S3_REGION=auto
S3_ACCOUNT_ID=
S3_BUCKET=ruxlog-assets
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_PUBLIC_URL=https://cdn.example.com
S3_ENDPOINT=https://cdn.example.com

# --- Firebase Cloud Messaging (optional; feature notifications) -------------
# When FCM_ENABLED=false OR the service-account file is absent, push is skipped
# but in-app notifications still work. Mount the JSON under the path below
# (e.g. a Docker secret / bind mount) — keep it out of git.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=/run/secrets/fcm-service-account.json

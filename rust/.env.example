# EasyQuran API — example environment for local development.
#
# Copy to `.env` and edit:   cp .env.example .env
# (Or run `just setup` from the repo root, which generates a COOKIE_KEY.)
#
# The default build runs on SQLite only — there is NO Postgres and NO Redis.
# Feature-gated providers (billing, FCM, WebAuthn, Cloudflare email, OAuth) are
# OFF in the default build and their keys are intentionally omitted here; add
# them only if you enable the corresponding cargo feature.

# ── Runtime ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
# 8800 — avoids clashing with the original ruxlog (1100) running alongside.
PORT=8800
# `development` lets the field-encryption key fall back to a non-secret dev
# default. Remove (or set to `production`) in real deployments.
RUST_ENV=development
APP_ENV=development

# Cookie-signing / keyed-hash secret. MUST be >= 32 bytes of CSPRNG output and
# must NOT be the placeholder below. Generate with:  openssl rand -hex 32
COOKIE_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32_______________________

# ── Database (SQLite — the only data store) ─────────────────────────────────
# `mode=rwc` creates the file on first boot; the data/ dir is ensured at startup.
DATABASE_URL=sqlite:./data/easyquran.db?mode=rwc

# ── Object storage (S3-compatible). Fail-closed: the four below MUST be set. ─
# Use any S3-compatible store (Cloudflare R2, Garage, MinIO, AWS S3, …).
S3_REGION=auto
S3_ACCOUNT_ID=local
S3_BUCKET=easyquran-assets
S3_ACCESS_KEY=devkey
S3_SECRET_KEY=devsecret
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000

# ── Mail ────────────────────────────────────────────────────────────────────
# `smtp` builds the transport lazily (no connection at boot); `cloudflare` needs
# the Cloudflare Email keys (mail-cloudflare feature).
MAIL_PROVIDER=smtp
MAIL_FROM_ADDRESS=no-reply@easyquran.local
MAIL_FROM_NAME=EasyQuran
# Required at boot when MAIL_PROVIDER=smtp:
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional tuning (defaults shown):
# MAIL_RATE_LIMIT_ENABLED=true
# MAIL_DEDUP_TTL_SECS=300
# MAIL_SOFT_BOUNCE_COOLDOWN_SECS=86400

# ── Telemetry ───────────────────────────────────────────────────────────────
# Disable OpenTelemetry export in local dev:
OTEL_SDK_DISABLED=true

# ── Field-level encryption at rest (optional) ───────────────────────────────
# Unset in dev -> documented non-secret default. Production MUST set a 32-byte
# key:  FIELD_ENC_KEY="$(openssl rand -base64 32 | head -c 32)"
# FIELD_ENC_KEY=

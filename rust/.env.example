# --- runtime (single-service dev, no docker) ---
APP_ENV=development
COOKIE_KEY=dev-only-local-cookie-key-32-bytes!!
DATABASE_URL=sqlite:./data/easyquran.db?mode=rwc

# --- storage (local MinIO) ---
S3_BUCKET=easyquran-assets
S3_ACCESS_KEY=devkey
S3_SECRET_KEY=devsecret
S3_ENDPOINT=http://localhost:9000

# --- mail (local SMTP catcher) ---
MAIL_PROVIDER=smtp
MAIL_FROM_ADDRESS=no-reply@easyquran.local
MAIL_FROM_NAME=EasyQuran
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- auth providers (uncomment to enable) ---
# WEB_AUTH_ENABLED=true
# WEB_OAUTH_PROVIDERS=github,discord,google
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FRONTEND_URL=http://localhost:5173

# Firebase web config — copy to `.env` and fill in from the Firebase console
# (Project settings → General → Your apps → SDK setup and configuration).
#
# These are PUBLIC by design: they ship in the client bundle. Access is gated by
# Security Rules / App Check, not by keeping them out of source. Until they're
# set, src/lib/firebase/* no-ops and analytics/performance/messaging never start.

PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Cloud Messaging (web push) ───────────────────────────────────────────
# VAPID key pair from Firebase console → Project settings → Cloud Messaging
# → Web configuration → Generate key pair. Without it, push cannot get a token.
PUBLIC_FIREBASE_VAPID_KEY=

# ── API base URLs (dual: client vs server-side generation) ─────────────────
# The browser uses PUBLIC_API_BASE_URL — it is PUBLIC, so it ships in the client
# bundle ($env/dynamic/public, web/src/lib/firebase/index.ts). In production it
# points at the public origin the edge proxy exposes:
#   PUBLIC_API_BASE_URL=https://easyquran.fyi/api
# When set, an FCM token is POSTed to `${PUBLIC_API_BASE_URL}/device/v1/register`
# on subscribe (requires a logged-in session). Leave empty locally until accounts
# ship — the token is kept locally meanwhile.
PUBLIC_API_BASE_URL=
# INTERNAL_API_BASE_URL is the server-side (build/prerender) counterpart: read
# via $env/dynamic/private, so it NEVER ships to the browser. In the VPS deploy
# it points at the in-container Docker network address so server-side generation
# is fast and never leaves the box:
#   INTERNAL_API_BASE_URL=http://api:8888
# Forward-ready: consumed once the /quran/v1 SSG flow lands. Unused locally.
INTERNAL_API_BASE_URL=

# ── Analytics debug (optional) ───────────────────────────────────────────
# Echo analytics events to the browser console for local development. For GA4's
# real-time DebugView, append ?firebase_debug_mode=1 to the URL instead.
PUBLIC_FIREBASE_ANALYTICS_DEBUG=false

# ── Owner profile source (optional — server-side / build-time only) ──────
# The email + X shown across the site are fetched at build time from this URL
# (default: https://hmziq.rs/me.json). Override for testing/staging. Read via
# $env/dynamic/private in src/lib/server/owner.ts — never shipped to the client.
OWNER_SOURCE_URL=

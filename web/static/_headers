# Text-variant alternates (/*.md, /*.txt) duplicate the HTML pages' content as
# markdown/plain text for LLMs and crawlers. Keep them crawlable (follow) but
# out of the search index (noindex) so the canonical HTML is what ranks.
# Effective on Cloudflare Pages / Netlify (copied to build/_headers). For
# Vercel, mirror these in vercel.json `headers`.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://www.googletagmanager.com; connect-src 'self' https://*.firebaseio.com wss://*.firebaseio.com https://firestore.googleapis.com https://firebase.googleapis.com https://firebaseremoteconfig.googleapis.com https://firebaselogging-pa.googleapis.com https://www.google-analytics.com https://www.google.com; worker-src 'self' blob:; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/_app/version.json
  Cache-Control: no-cache

/offline/manifest.json
  Cache-Control: no-cache

/offline/pack.*.json
  Cache-Control: public, max-age=31536000, immutable

/service-worker.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/quran-meta/*
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

/*/__data.json
  Cache-Control: no-cache

/*.md
  X-Robots-Tag: noindex, follow

/*.txt
  X-Robots-Tag: noindex, follow

{
  "private": true,
  "workspaces": {
    "packages": [
      "web"
    ],
    "catalog": {
      "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
      "vite-plus": "1.0.0"
    }
  },
  "type": "module",
  "scripts": {
    "font:indopak:preview": "python3 scripts/fonts/indopak/build.py --preview",
    "font:indopak:audit": "python3 scripts/fonts/indopak/audit.py --font web/static/fonts/indopak-reader-compat-v2.ttf --font web/static/fonts/indopak-reader-compat-v2.woff2",
    "font:indopak:test": "python3 -m unittest discover -s scripts/fonts/indopak -p 'test_*.py'",
    "font:indopak:browser": "node scripts/fonts/indopak/browser-check.mjs",
    "quran:check": "pnpm quran:typecheck && pnpm quran:test",
    "quran:test": "tsx --test scripts/quran/upload.test.ts",
    "quran:upload": "tsx scripts/quran/upload.ts",
    "quran:typecheck": "tsc --noEmit -p scripts/quran/tsconfig.json",
    "prepare": "vp config"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.709.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "download"
    }
  },
  "patchedDependencies": {
    "@tanstack/hotkeys@0.8.0": "patches/@tanstack__hotkeys@0.8.0.patch",
    "@tanstack/svelte-store@0.12.1": "patches/@tanstack__svelte-store@0.12.1.patch"
  }
}

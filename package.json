{
  "private": true,
  "workspaces": {
    "packages": [
      "web"
    ],
    "catalog": {
      "vite": "8.3.1"
    }
  },
  "type": "module",
  "scripts": {
    "font:indopak:preview": "python3 scripts/fonts/indopak/build.py --preview",
    "font:indopak:audit": "python3 scripts/fonts/indopak/audit.py --font web/static/fonts/indopak-reader-compat-v4.ttf --font web/static/fonts/indopak-reader-compat-v4.woff2",
    "font:indopak:test": "python3 -m unittest discover -s scripts/fonts/indopak -p 'test_*.py'",
    "font:indopak:browser": "node scripts/fonts/indopak/browser-check.mjs",
    "quran:audit": "tsx scripts/quran/audit-qurancom-parity.ts",
    "quran:check": "bun run quran:typecheck && bun run quran:test",
    "quran:mirror": "tsx scripts/quran/mirror-qurancom.ts",
    "quran:test": "tsx --test scripts/quran/upload.test.ts scripts/quran/qurancom-mirror.test.ts scripts/quran/qurancom-parity.test.ts",
    "quran:upload": "tsx scripts/quran/upload.ts",
    "quran:typecheck": "tsc --noEmit -p scripts/quran/tsconfig.json",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.709.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "playwright": "1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "catalog:"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6",
    "nanoid": "3.3.18",
    "source-map-js": "1.2.2"
  },
  "patchedDependencies": {
    "@tanstack/hotkeys@0.8.0": "patches/@tanstack__hotkeys@0.8.0.patch",
    "@tanstack/svelte-store@0.12.1": "patches/@tanstack__svelte-store@0.12.1.patch"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild",
    "puppeteer"
  ]
}

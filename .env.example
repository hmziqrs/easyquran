# --- site ---
DOMAIN=easyquran.fyi
COOKIE_KEY=CHANGE_ME_openssl_rand_hex_32
FIELD_ENC_KEY=CHANGE_ME_32_raw_bytes
INTERNAL_QURAN_API_TOKEN=CHANGE_ME_openssl_rand_hex_32
ALLOWED_ORIGINS=https://easyquran.fyi,https://hmziq.rs,https://hzmiqrs.com,https://blog.hmziq.rs
FRONTEND_URL=https://easyquran.fyi

# --- mail ---
MAIL_PROVIDER=cloudflare
MAIL_FROM_ADDRESS=no-reply@send.easyquran.fyi
MAIL_REPLY_TO=support@easyquran.fyi
MAIL_FROM_NAME=EasyQuran
CLOUDFLARE_EMAIL_API_TOKEN=

# --- storage ---
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
S3_BUCKET=easyquran

# --- auth ---
WEB_AUTH_ENABLED=true
WEB_OAUTH_PROVIDERS=github,discord,google
# Account-email plus-tags (user+tag@example.com). Unset: on in development, off in production.
# EMAIL_ALIASES_ENABLED=
# Cloudflare Turnstile secret (register captcha). Unset: gate off.
# TURNSTILE_SECRET_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

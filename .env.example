# --- site ---
DOMAIN=easyquran.fyi
COOKIE_KEY=CHANGE_ME_openssl_rand_hex_32
FIELD_ENC_KEY=CHANGE_ME_32_raw_bytes
INTERNAL_QURAN_API_TOKEN=CHANGE_ME_openssl_rand_hex_32
# Edge proof: same value in the Cloudflare Transform Rule that sets x-eq-ingress-marker.
INGRESS_TRUST_MODE=cloudflare_tunnel
INGRESS_EDGE_MARKER=CHANGE_ME_openssl_rand_hex_32
ALLOWED_ORIGINS=https://easyquran.fyi,https://hmziq.rs,https://hzmiqrs.com,https://blog.hmziq.rs
FRONTEND_URL=https://easyquran.fyi

# --- mail ---
MAIL_PROVIDER=cloudflare
MAIL_FROM_ADDRESS=no-reply@send.easyquran.fyi
MAIL_REPLY_TO=support@easyquran.fyi
MAIL_FROM_NAME=EasyQuran
CLOUDFLARE_EMAIL_API_TOKEN=
# Shared secret for POST /mail/v1/webhook/cloudflare. Production prerequisite (A29): ship it only with the admin review of webhook suppressions in place.
CLOUDFLARE_EMAIL_WEBHOOK_SECRET=
# Public base of this API, used in newsletter List-Unsubscribe links (RFC 8058), e.g. https://easyquran.fyi/api. Unset: no unsubscribe header.
API_PUBLIC_URL=

# --- storage ---
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
S3_BUCKET=easyquran

# --- auth ---
WEB_AUTH_ENABLED=true
WEB_OAUTH_PROVIDERS=github,discord,google
# Account-email plus-tags (user+tag@example.com). Unset: on in development, off in production.
# EMAIL_ALIASES_ENABLED=
# Keys the HMAC that groups accounts by canonical mailbox (registration caps). Required in production.
VERIFICATION_IDENTITY_KEY=CHANGE_ME_openssl_rand_hex_32
# Required for password registration in production. Pair from Cloudflare Turnstile.
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=
# Public Argon2 lane size, default 2; allowed range 1..32. The dummy and authenticated lanes add one slot each.
PASSWORD_WORK_CONCURRENCY=2
# Private API handler budget in seconds (504 past it), default 60; clamped to 5..95 so it answers before Cloudflare's 100 s 524. Media, erasure and seed routes are exempt.
# REQUEST_TIMEOUT_SECS=60
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

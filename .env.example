# --- runtime ---
APP_ENV=development
COOKIE_KEY=CHANGE_ME_openssl_rand_hex_32

# --- storage (local MinIO) ---
S3_BUCKET=easyquran-assets
S3_ACCESS_KEY=devkey
S3_SECRET_KEY=devsecret

# --- mail (local SMTP catcher) ---
MAIL_PROVIDER=smtp
MAIL_FROM_ADDRESS=no-reply@easyquran.local
MAIL_FROM_NAME=EasyQuran
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- web dev ---
PUBLIC_QURAN_API_BASE=http://127.0.0.1:8888/quran

# --- auth providers (uncomment to enable) ---
# WEB_AUTH_ENABLED=true
# WEB_OAUTH_PROVIDERS=github,discord,google
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FRONTEND_URL=http://localhost:5173

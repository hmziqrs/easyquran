# Cloudflare R2 — for `just upload-sqlite` (and upload.ts) from the repo root.
# Copy to `.env` and fill in. `.env` is gitignored; this file is the template.
#
#   cp .env.example .env
#
# Get these from: Cloudflare dashboard → R2 → Manage API Tokens → Create token
# (Object Read & Write, scoped to the easyquran bucket). The Secret Access Key
# is shown only once.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

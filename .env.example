# EasyQuran dev env — copy to .env (`just setup` does this). SQLite only.

# Runtime
HOST=0.0.0.0
PORT=8888
# development | production
APP_ENV=development

# Mount OAuth/passkey routes
WEB_AUTH_ENABLED=true
# openssl rand -hex 32
COOKIE_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32_______________________

# SQLite; created on first boot
DATABASE_URL=sqlite:./data/easyquran.db?mode=rwc

# Media storage (R2); dev falls back to http://localhost:9000 (MinIO)
S3_BUCKET=easyquran-assets
S3_ACCESS_KEY=devkey
S3_SECRET_KEY=devsecret
# S3_PUBLIC_URL=https://r2.easyquran.fyi
# Optional overrides: S3_ENDPOINT / S3_REGION

# Mail (smtp connects lazily)
MAIL_PROVIDER=smtp
MAIL_FROM_ADDRESS=no-reply@easyquran.local
MAIL_FROM_NAME=EasyQuran
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# OpenTelemetry; off in dev
OTEL_SDK_DISABLED=true

# Web client (PUBLIC_* ship to the browser); dev proxies /api to PORT above
PUBLIC_API_BASE_URL=
CONSUMER_PORT=5173
OWNER_SOURCE_URL=
PUBLIC_QURAN_API_BASE=http://127.0.0.1:8888/quran
INTERNAL_QURAN_API_BASE=

# Cloudflare account id + R2 token (publisher + media API share them)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Auth providers — uncomment what you need; callback URLs derive from FRONTEND_URL
# FRONTEND_URL=https://easyquran.fyi
# WEB_OAUTH_PROVIDERS=github,discord,google
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# Overrides only: *_REDIRECT_URI / OAUTH_ALLOWED_REDIRECT_ORIGINS / WEBAUTHN_RP_ID / WEBAUTHN_RP_ORIGIN / WEBAUTHN_RP_NAME
